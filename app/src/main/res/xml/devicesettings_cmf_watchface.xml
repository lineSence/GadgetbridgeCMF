<?xml version="1.0" encoding="utf-8"?>
<!--
    Entry point for the watchface editor.

    The preference opens the editor by action, not by class name, so this file can live in the main
    source set while the editor itself is declared in debug builds only. In a release build the
    entry simply does nothing.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="pref_category_cmf_watchface"
        android:title="Циферблаты">

        <Preference
            android:key="cmf_watchface_editor_open"
            android:persistent="false"
            android:summary="Своё фото на циферблате: обрезка, стиль часов, цвет, положение и загрузка на часы"
            android:title="Редактор циферблатов">

            <intent android:action="nodomain.freeyourgadget.gadgetbridge.cmf.watchface.OPEN" />
        </Preference>

    </PreferenceCategory>

</PreferenceScreen>
