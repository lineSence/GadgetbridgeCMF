<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest additions for the CMF Watch Pro 2 microphone recorder PoC.

  This source set is merged into debug variants only, so release builds keep
  their original permission set and do not ship the recorder service.
  Before promoting the PoC to a shipping feature, move these entries into
  app/src/main/AndroidManifest.xml and set android:exported="false".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Records audio from the watch microphone over the Bluetooth SCO link. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application>
        <!--
          exported="true" only so the PoC can be driven from adb:
            adb shell am start-foreground-service -n <pkg>/nodomain.freeyourgadget.gadgetbridge.service.devices.cmfwatchpro.recorder.CmfMicRecorderService -a nodomain.freeyourgadget.gadgetbridge.cmf.recorder.SELFTEST
        -->
        <service
            android:name="nodomain.freeyourgadget.gadgetbridge.service.devices.cmfwatchpro.recorder.CmfMicRecorderService"
            android:exported="true"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
