<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug only additions for the CMF microphone recorder PoC.

    Everything here is merged into debug builds only, so release builds gain no new
    permissions and no new components. See docs/CMF_MIC_RECORDER.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Needed to place the self-managed VoIP call that makes the platform tell the watch a call
        is in progress, which is what unmutes its microphone. Install time permission, no dialog,
        no telephony access and nothing is ever dialled.
    -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <application>

        <!--
            The recorder screen: start/stop, SCO self test, the source and sample rate sweep,
            duration, format and output folder. It is exported and has a launcher entry so the
            PoC can be driven entirely from the phone, without adb.
        -->
        <activity
            android:name="nodomain.freeyourgadget.gadgetbridge.service.devices.cmfwatchpro.recorder.CmfRecorderActivity"
            android:exported="true"
            android:label="CMF диктофон"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Used by the "Диктофон" entry in the watch settings, no class name needed there. -->
            <intent-filter>
                <action android:name="nodomain.freeyourgadget.gadgetbridge.cmf.recorder.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="nodomain.freeyourgadget.gadgetbridge.service.devices.cmfwatchpro.recorder.CmfMicRecorderService"
            android:exported="true"
            android:foregroundServiceType="microphone" />

        <!--
            Self-managed connection service used to simulate an ongoing call. Telecom requires the
            BIND_TELECOM_CONNECTION_SERVICE permission on the component, which only the system
            holds, so nothing else on the device can bind to it.
        -->
        <service
            android:name="nodomain.freeyourgadget.gadgetbridge.service.devices.cmfwatchpro.recorder.CmfTelecomCallShim"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">

            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

    </application>

</manifest>
